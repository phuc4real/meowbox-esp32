diff --git a/main/boards/ostb/ostb-xiaozhi-3st/ostb_xiaozhi_3st.cc b/main/boards/ostb/ostb-xiaozhi-3st/ostb_xiaozhi_3st.cc
new file mode 100644
index 0000000..87c1358
--- /dev/null
+++ b/main/boards/ostb/ostb-xiaozhi-3st/ostb_xiaozhi_3st.cc
@@ -0,0 +1,289 @@
+#include "wifi_board.h"
+#include "codecs/box_audio_codec.h"
+#include "display/lcd_display.h"
+#include "application.h"
+#include "button.h"
+#include "config.h"
+#include "power_save_timer.h"
+#include "assets/lang_config.h"
+#include "../../nologo/xingzhi-cube-1.54tft-wifi/power_manager.h"
+
+#include <esp_log.h>
+#include <driver/i2c_master.h>
+#include <esp_lcd_panel_ops.h>
+#include <esp_lcd_nv3023.h>
+#include <esp_lcd_touch_cst816s.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+
+#define TAG "OSTB_XIAOZHI_3ST"
+
+// Init sequence copied verbatim from the vendor firmware (25 commands)
+static const nv3023_lcd_init_cmd_t lcd_init_cmds[] = {
+    {0xdf, (uint8_t[]){0x98, 0x53}, 2, 0},
+    {0xde, (uint8_t[]){0x00}, 1, 0},
+    {0xb2, (uint8_t[]){0x25}, 1, 0},
+    {0xb7, (uint8_t[]){0x00, 0x29, 0x00, 0x51}, 4, 0},
+    {0xbb, (uint8_t[]){0x4f, 0x1a, 0x55, 0x73, 0x63, 0xf0}, 6, 0},
+    {0xc0, (uint8_t[]){0x44, 0xa4}, 2, 0},
+    {0xc1, (uint8_t[]){0x12}, 1, 0},
+    {0xc3, (uint8_t[]){0x7d, 0x07, 0x14, 0x06, 0xc8, 0x71, 0x6c, 0x77}, 8, 0},
+    {0xc4, (uint8_t[]){0x00, 0x00, 0x94, 0x79, 0x25, 0x0a, 0x16, 0x79, 0x25, 0x0a, 0x16, 0x82}, 12, 0},
+    {0xc8, (uint8_t[]){0x3f, 0x34, 0x2d, 0x26, 0x2b, 0x2b, 0x25, 0x24, 0x23, 0x22, 0x20, 0x17, 0x14, 0x0e, 0x06, 0x00,
+                       0x3f, 0x34, 0x2d, 0x26, 0x2b, 0x2b, 0x25, 0x24, 0x23, 0x22, 0x20, 0x17, 0x14, 0x0e, 0x06, 0x00}, 32, 0},
+    {0xd0, (uint8_t[]){0x04, 0x06, 0x6b, 0x0f, 0x00}, 5, 0},
+    {0xd7, (uint8_t[]){0x00, 0x30}, 2, 0},
+    {0xe6, (uint8_t[]){0x10}, 1, 0},
+    {0xde, (uint8_t[]){0x01}, 1, 0},
+    {0xb7, (uint8_t[]){0x03, 0x13, 0xef, 0x35, 0x35}, 5, 0},
+    {0xc1, (uint8_t[]){0x14, 0x15, 0xc0}, 3, 0},
+    {0xc2, (uint8_t[]){0x06, 0x3a}, 2, 0},
+    {0xc4, (uint8_t[]){0x72, 0x12}, 2, 0},
+    {0xbe, (uint8_t[]){0x00}, 1, 0},
+    {0xde, (uint8_t[]){0x00}, 1, 0},
+    {0x35, (uint8_t[]){0x00}, 1, 0},
+    {0x3a, (uint8_t[]){0x05}, 1, 0},
+    {0x2a, (uint8_t[]){0x00, 0x00, 0x00, 0xef}, 4, 0},
+    {0x2b, (uint8_t[]){0x00, 0x00, 0x01, 0x27}, 4, 0},
+    {0x11, (uint8_t[]){0x00}, 0, 120},
+};
+
+class OstbXiaozhi3stBoard : public WifiBoard {
+private:
+    i2c_master_bus_handle_t i2c_bus_ = nullptr;
+    esp_lcd_panel_io_handle_t panel_io_ = nullptr;
+    esp_lcd_panel_handle_t panel_ = nullptr;
+    esp_lcd_touch_handle_t touch_ = nullptr;
+    SpiLcdDisplay* display_ = nullptr;
+    PowerSaveTimer* power_save_timer_ = nullptr;
+    PowerManager* power_manager_ = nullptr;
+    Button boot_button_;
+    Button volume_up_button_;
+    Button volume_down_button_;
+
+    void InitializeI2c() {
+        i2c_master_bus_config_t cfg = {
+            .i2c_port = I2C_NUM_0,
+            .sda_io_num = AUDIO_CODEC_I2C_SDA_PIN,
+            .scl_io_num = AUDIO_CODEC_I2C_SCL_PIN,
+            .clk_source = I2C_CLK_SRC_DEFAULT,
+            .glitch_ignore_cnt = 7,
+            .intr_priority = 0,
+            .trans_queue_depth = 0,
+            .flags = {
+                .enable_internal_pullup = 1,
+            },
+        };
+        ESP_ERROR_CHECK(i2c_new_master_bus(&cfg, &i2c_bus_));
+    }
+
+    void InitializePowerManager() {
+        power_manager_ = new PowerManager(CHARGING_DETECT_GPIO);
+        power_manager_->OnChargingStatusChanged([this](bool is_charging) {
+            power_save_timer_->SetEnabled(!is_charging);
+        });
+    }
+
+    void InitializePowerSaveTimer() {
+        // Dim the screen after 60s idle; never shut down (the vendor firmware didn't either)
+        power_save_timer_ = new PowerSaveTimer(-1, 60, -1);
+        power_save_timer_->OnEnterSleepMode([this]() {
+            GetDisplay()->SetPowerSaveMode(true);
+            GetBacklight()->SetBrightness(1);
+        });
+        power_save_timer_->OnExitSleepMode([this]() {
+            GetDisplay()->SetPowerSaveMode(false);
+            GetBacklight()->RestoreBrightness();
+        });
+        power_save_timer_->SetEnabled(true);
+    }
+
+    void InitializeSpi() {
+        spi_bus_config_t buscfg = {};
+        buscfg.mosi_io_num = DISPLAY_MOSI;
+        buscfg.miso_io_num = GPIO_NUM_NC;
+        buscfg.sclk_io_num = DISPLAY_SCLK;
+        buscfg.quadwp_io_num = GPIO_NUM_NC;
+        buscfg.quadhd_io_num = GPIO_NUM_NC;
+        buscfg.max_transfer_sz = DISPLAY_HEIGHT * 80 * sizeof(uint16_t);
+        ESP_ERROR_CHECK(spi_bus_initialize(SPI3_HOST, &buscfg, SPI_DMA_CH_AUTO));
+    }
+
+    void InitializeNv3023Display() {
+        esp_lcd_panel_io_spi_config_t io_config = NV3023_PANEL_IO_SPI_CONFIG(DISPLAY_CS, DISPLAY_DC, NULL, NULL);
+        io_config.pclk_hz = 40 * 1000 * 1000;
+        ESP_ERROR_CHECK(esp_lcd_new_panel_io_spi((esp_lcd_spi_bus_handle_t)SPI3_HOST, &io_config, &panel_io_));
+
+        nv3023_vendor_config_t vendor_config = {
+            .init_cmds = lcd_init_cmds,
+            .init_cmds_size = sizeof(lcd_init_cmds) / sizeof(nv3023_lcd_init_cmd_t),
+        };
+        esp_lcd_panel_dev_config_t panel_config = {};
+        panel_config.reset_gpio_num = DISPLAY_RST;
+        panel_config.rgb_ele_order = LCD_RGB_ELEMENT_ORDER_RGB;
+        panel_config.bits_per_pixel = 16;
+        panel_config.vendor_config = &vendor_config;
+
+        ESP_ERROR_CHECK(esp_lcd_new_panel_nv3023(panel_io_, &panel_config, &panel_));
+        ESP_ERROR_CHECK(esp_lcd_panel_reset(panel_));
+        ESP_ERROR_CHECK(esp_lcd_panel_init(panel_));
+        ESP_ERROR_CHECK(esp_lcd_panel_swap_xy(panel_, DISPLAY_SWAP_XY));
+        ESP_ERROR_CHECK(esp_lcd_panel_mirror(panel_, DISPLAY_MIRROR_X, DISPLAY_MIRROR_Y));
+        ESP_ERROR_CHECK(esp_lcd_panel_invert_color(panel_, false));
+        ESP_ERROR_CHECK(esp_lcd_panel_disp_on_off(panel_, true));
+
+        display_ = new SpiLcdDisplay(panel_io_, panel_, DISPLAY_WIDTH, DISPLAY_HEIGHT,
+            DISPLAY_OFFSET_X, DISPLAY_OFFSET_Y, DISPLAY_MIRROR_X, DISPLAY_MIRROR_Y, DISPLAY_SWAP_XY);
+    }
+
+    // Tap anywhere on the screen = start/stop talking (same as the boot button)
+    static void TouchTask(void* arg) {
+        auto* self = static_cast<OstbXiaozhi3stBoard*>(arg);
+        bool was_touched = false;
+        while (true) {
+            esp_lcd_touch_point_data_t point;
+            uint8_t count = 0;
+            esp_lcd_touch_read_data(self->touch_);
+            esp_lcd_touch_get_data(self->touch_, &point, &count, 1);
+            bool touched = count > 0;
+            if (touched && !was_touched) {
+                self->OnMainAction();
+            }
+            was_touched = touched;
+            vTaskDelay(pdMS_TO_TICKS(50));
+        }
+    }
+
+    void InitializeTouch() {
+        esp_lcd_panel_io_handle_t tp_io = nullptr;
+        // Filled by hand: the component's C macro uses designators in an order C++ rejects
+        esp_lcd_panel_io_i2c_config_t tp_io_config = {};
+        tp_io_config.dev_addr = TOUCH_I2C_ADDR;
+        tp_io_config.scl_speed_hz = 400 * 1000;
+        tp_io_config.control_phase_bytes = 1;
+        tp_io_config.dc_bit_offset = 0;
+        tp_io_config.lcd_cmd_bits = 8;
+        tp_io_config.lcd_param_bits = 0;
+        tp_io_config.flags.disable_control_phase = 1;
+        if (esp_lcd_new_panel_io_i2c(i2c_bus_, &tp_io_config, &tp_io) != ESP_OK) {
+            ESP_LOGW(TAG, "Touch panel IO init failed, touch disabled");
+            return;
+        }
+        esp_lcd_touch_config_t tp_cfg = {};
+        tp_cfg.x_max = DISPLAY_WIDTH;
+        tp_cfg.y_max = DISPLAY_HEIGHT;
+        tp_cfg.rst_gpio_num = GPIO_NUM_NC;
+        tp_cfg.int_gpio_num = GPIO_NUM_NC;
+        if (esp_lcd_touch_new_i2c_cst816s(tp_io, &tp_cfg, &touch_) != ESP_OK) {
+            ESP_LOGW(TAG, "CST816S not found, touch disabled");
+            touch_ = nullptr;
+            return;
+        }
+        xTaskCreate(TouchTask, "touch", 3072, this, 4, nullptr);
+    }
+
+    void OnMainAction() {
+        power_save_timer_->WakeUp();
+        auto& app = Application::GetInstance();
+        if (app.GetDeviceState() == kDeviceStateStarting) {
+            EnterWifiConfigMode();
+            return;
+        }
+        app.ToggleChatState();
+    }
+
+    void ChangeVolume(int delta) {
+        power_save_timer_->WakeUp();
+        auto& app = Application::GetInstance();
+        if (app.GetDeviceState() == kDeviceStateStarting) {
+            EnterWifiConfigMode();
+            return;
+        }
+        auto codec = GetAudioCodec();
+        int volume = codec->output_volume() + delta;
+        if (volume > 100) volume = 100;
+        if (volume < 0) volume = 0;
+        codec->SetOutputVolume(volume);
+        GetDisplay()->ShowNotification(Lang::Strings::VOLUME + std::to_string(volume));
+    }
+
+    void InitializeButtons() {
+        boot_button_.OnClick([this]() { OnMainAction(); });
+
+        volume_up_button_.OnClick([this]() { ChangeVolume(+10); });
+        volume_up_button_.OnLongPress([this]() {
+            power_save_timer_->WakeUp();
+            GetAudioCodec()->SetOutputVolume(100);
+            GetDisplay()->ShowNotification(Lang::Strings::MAX_VOLUME);
+        });
+
+        volume_down_button_.OnClick([this]() { ChangeVolume(-10); });
+        volume_down_button_.OnLongPress([this]() {
+            power_save_timer_->WakeUp();
+            GetAudioCodec()->SetOutputVolume(0);
+            GetDisplay()->ShowNotification(Lang::Strings::MUTED);
+        });
+    }
+
+public:
+    OstbXiaozhi3stBoard() :
+        boot_button_(BOOT_BUTTON_GPIO),
+        volume_up_button_(VOLUME_UP_BUTTON_GPIO),
+        volume_down_button_(VOLUME_DOWN_BUTTON_GPIO) {
+        InitializeI2c();
+        InitializePowerSaveTimer();
+        InitializePowerManager();
+        InitializeSpi();
+        InitializeNv3023Display();
+        InitializeTouch();
+        InitializeButtons();
+        GetBacklight()->RestoreBrightness();
+    }
+
+    virtual AudioCodec* GetAudioCodec() override {
+        static BoxAudioCodec audio_codec(
+            i2c_bus_,
+            AUDIO_INPUT_SAMPLE_RATE,
+            AUDIO_OUTPUT_SAMPLE_RATE,
+            AUDIO_I2S_GPIO_MCLK,
+            AUDIO_I2S_GPIO_BCLK,
+            AUDIO_I2S_GPIO_WS,
+            AUDIO_I2S_GPIO_DOUT,
+            AUDIO_I2S_GPIO_DIN,
+            AUDIO_CODEC_PA_PIN,
+            AUDIO_CODEC_ES8311_ADDR,
+            AUDIO_CODEC_ES7210_ADDR,
+            AUDIO_INPUT_REFERENCE);
+        return &audio_codec;
+    }
+
+    virtual Display* GetDisplay() override {
+        return display_;
+    }
+
+    virtual Backlight* GetBacklight() override {
+        static PwmBacklight backlight(DISPLAY_BACKLIGHT_PIN, DISPLAY_BACKLIGHT_OUTPUT_INVERT);
+        return &backlight;
+    }
+
+    virtual bool GetBatteryLevel(int& level, bool& charging, bool& discharging) override {
+        static bool last_discharging = false;
+        charging = power_manager_->IsCharging();
+        discharging = power_manager_->IsDischarging();
+        if (discharging != last_discharging) {
+            power_save_timer_->SetEnabled(discharging);
+            last_discharging = discharging;
+        }
+        level = power_manager_->GetBatteryLevel();
+        return true;
+    }
+
+    virtual void SetPowerSaveLevel(PowerSaveLevel level) override {
+        if (level != PowerSaveLevel::LOW_POWER) {
+            power_save_timer_->WakeUp();
+        }
+        WifiBoard::SetPowerSaveLevel(level);
+    }
+};
+
+DECLARE_BOARD(OstbXiaozhi3stBoard);
diff --git a/partitions/v2/16m_ostb.csv b/partitions/v2/16m_ostb.csv
new file mode 100644
index 0000000..3c50e9a
--- /dev/null
+++ b/partitions/v2/16m_ostb.csv
@@ -0,0 +1,8 @@
+# Same layout as the OSTB vendor firmware, so ota_0 (vendor app) stays untouched
+# Name,   Type, SubType, Offset,   Size,     Flags
+nvs,      data, nvs,     0x9000,   0x4000,
+otadata,  data, ota,     0xd000,   0x2000,
+phy_init, data, phy,     0xf000,   0x1000,
+ota_0,    app,  ota_0,   0x20000,  0x540000,
+ota_1,    app,  ota_1,   0x560000, 0x540000,
+assets,   data, spiffs,  0xaa0000, 0x560000,
