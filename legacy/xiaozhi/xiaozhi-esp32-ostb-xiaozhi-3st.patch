@@ -0,0 +1,50 @@
+#ifndef _BOARD_CONFIG_H_
+#define _BOARD_CONFIG_H_
+
+// OSTB xiaozhi-3st (ESP32-S3 N16R8, ES8311 + ES7210, NV3023 TFT, CST816S touch)
+// Pin map reverse-engineered from the vendor firmware, see /PINMAP.md
+
+#include <driver/gpio.h>
+
+#define AUDIO_INPUT_SAMPLE_RATE  24000
+#define AUDIO_OUTPUT_SAMPLE_RATE 24000
+#define AUDIO_INPUT_REFERENCE    true
+
+#define AUDIO_I2S_GPIO_MCLK GPIO_NUM_5
+#define AUDIO_I2S_GPIO_BCLK GPIO_NUM_15
+#define AUDIO_I2S_GPIO_WS   GPIO_NUM_16
+#define AUDIO_I2S_GPIO_DOUT GPIO_NUM_6
+#define AUDIO_I2S_GPIO_DIN  GPIO_NUM_7
+
+#define AUDIO_CODEC_PA_PIN       GPIO_NUM_4
+#define AUDIO_CODEC_I2C_SDA_PIN  GPIO_NUM_12
+#define AUDIO_CODEC_I2C_SCL_PIN  GPIO_NUM_11
+#define AUDIO_CODEC_ES8311_ADDR  ES8311_CODEC_DEFAULT_ADDR   // 0x18 (0x30 8-bit)
+#define AUDIO_CODEC_ES7210_ADDR  ES7210_CODEC_DEFAULT_ADDR   // 0x40 (0x80 8-bit)
+
+#define BOOT_BUTTON_GPIO        GPIO_NUM_0
+#define VOLUME_UP_BUTTON_GPIO   GPIO_NUM_40
+#define VOLUME_DOWN_BUTTON_GPIO GPIO_NUM_39
+
+#define CHARGING_DETECT_GPIO    GPIO_NUM_47
+
+#define TOUCH_I2C_ADDR          0x15
+
+#define DISPLAY_MOSI  GPIO_NUM_10
+#define DISPLAY_SCLK  GPIO_NUM_9
+#define DISPLAY_DC    GPIO_NUM_8
+#define DISPLAY_CS    GPIO_NUM_14
+#define DISPLAY_RST   GPIO_NUM_18
+
+#define DISPLAY_WIDTH     296
+#define DISPLAY_HEIGHT    240
+#define DISPLAY_SWAP_XY   true
+#define DISPLAY_MIRROR_X  false
+#define DISPLAY_MIRROR_Y  true
+#define DISPLAY_OFFSET_X  24
+#define DISPLAY_OFFSET_Y  0
+
+#define DISPLAY_BACKLIGHT_PIN           GPIO_NUM_13
+#define DISPLAY_BACKLIGHT_OUTPUT_INVERT false
+
+#endif // _BOARD_CONFIG_H_
